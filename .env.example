# Скопируйте в .env и заполните. Файл .env не коммитится.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ шифрования токенов пользователей в базе. Создать: python -m investment_journal --generate-key
# Не теряйте и не меняйте: со сменой ключа сохранённые токены перестанут расшифровываться.
TOKEN_ENCRYPTION_KEY=

# 1 — песочница https://sandbox-invest-public-api.tbank.ru/mcp вместо боевого сервера
TINVEST_SANDBOX=0

# Сертификаты Минцифры (https://www.gosuslugi.ru/crt): без них не пройдёт проверка TLS
# у invest-public-api.tbank.ru. Пути через запятую, файлы в формате PEM/CER.
TINVEST_CA_FILES=certs/russian_trusted_root_ca.cer,certs/russian_trusted_sub_ca.cer

# Токены T-Invest API пользователи подключают в боте командой /connect.
# TINKOFF_TOKEN нужен только для проверки: python -m investment_journal --list-tools
# TINKOFF_TOKEN=

# Сервер — официальный T-Invest MCP https://invest-public-api.tbank.ru/mcp.
# Другой адрес (Streamable HTTP):
# TINVEST_MCP_URL=
# Инструменты, которые разрешено вызывать LLM (по умолчанию — все инструменты чтения, без заявок):
# TINVEST_MCP_READ_TOOLS=invest_find_instrument,invest_get_market_values,invest_get_candles,invest_get_portfolio

# Файл базы журнала
JOURNAL_DB=journal.sqlite3

# Свободный диалог: любая LLM с OpenAI-совместимым API (OpenAI, DeepSeek, OpenRouter, Ollama, LM Studio...)
# Оставьте пустыми, чтобы отключить.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
