# Скопируйте в .env и заполните. Файл .env не коммитится.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Токен T-Invest API (лучше «только чтение»): https://www.tbank.ru/invest/settings/api/
TINKOFF_TOKEN=
# Номер счёта (пусто — первый счёт)
TINKOFF_ACCOUNT_ID=
# 1 — песочница (нужен токен песочницы)
TINVEST_SANDBOX=0

# Команда запуска MCP-сервера (stdio). По умолчанию — tinvest-mcp из пакета t-invest-tinkoff-mcp
TINVEST_MCP_COMMAND=tinvest-mcp
TINVEST_MCP_ARGS=
# Имена инструментов, если используется другой MCP-сервер
# TINVEST_MCP_PRICE_TOOL=get_last_price
# TINVEST_MCP_CANDLES_TOOL=get_candles
# TINVEST_MCP_PORTFOLIO_TOOL=get_portfolio
# TINVEST_MCP_READ_TOOLS=get_last_price,get_candles,get_portfolio

# Файл базы журнала
JOURNAL_DB=journal.sqlite3

# Свободный диалог: любая LLM с OpenAI-совместимым API (OpenAI, DeepSeek, OpenRouter, Ollama, LM Studio...)
# Оставьте пустыми, чтобы отключить.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
